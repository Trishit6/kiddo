# Copy to .env for local overrides. Every value below has a development-safe
# default in apps/api/src/env.ts, so the stack also runs without a .env file.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Global per-IP/per-route limit. Raise it for load tests; keep 300 in production.
RATE_LIMIT_MAX=300

# Postgres (docker-compose.yml creates both `reel` and `reel_test`)
DATABASE_URL=postgresql://reel:reel@localhost:5432/reel
TEST_DATABASE_URL=postgresql://reel:reel@localhost:5432/reel_test

# Redis (test suite uses logical DB 1 so it never touches dev data)
# Compose uses host port 6380 to avoid collisions with common local Redis services.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# MinIO / S3-compatible storage. S3_ENDPOINT is used by the API/worker;
# S3_PUBLIC_ENDPOINT and MEDIA_PUBLIC_BASE_URL must be reachable by browsers and
# phones (use the LAN IP for a physical device, or a CDN in production).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=reelminio
S3_SECRET_ACCESS_KEY=reelminio123
S3_BUCKET=reel-videos
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/reel-videos
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/reel-videos

# Video processing
VIDEO_PROVIDER=local-ffmpeg
MAX_VIDEO_MB=200
MAX_VIDEO_SECONDS=60
MIN_VIDEO_SECONDS=1
MAX_VIDEO_DIMENSION=4096
KEEP_ORIGINAL_DAYS=7
WORKER_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Auth secrets and token lifetimes. Replace all secrets in production.
APP_URL=http://localhost:5173
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=reel-api
JWT_AUDIENCE=reel-app
COOKIE_SECRET=dev-only-cookie-secret-change-me

# Mail (Mailpit is exposed in docker-compose.yml on http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Reel <no-reply@reel.local>

# Optional Google login. Leave both blank to disable Google sign-in everywhere.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_MOBILE_CLIENT_ID=

# Client apps
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
