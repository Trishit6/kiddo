# Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:3000
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional Google sign-in. The button is hidden when these are unset.
# Use the web client ID as the Android audience and the iOS client ID for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Restart Expo with `pnpm --filter @reel/mobile dev -- --clear` after changing this file.
